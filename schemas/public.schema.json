{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readcode.example/schemas/public.schema.json",
  "title": "ReadCode public exercise definition (safe to send to candidates)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "language",
    "level",
    "estimated_minutes",
    "concepts",
    "files",
    "license",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^readcode-[0-9]{3,}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "intro": {
      "type": "string",
      "minLength": 10,
      "description": "Shown before the questions: what the code is and what was stubbed out."
    },
    "brief": {
      "description": "The story behind the code: what it is for and the constraints it was built under, so design and improvement questions have a starting point.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "constraints"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "language": {
      "enum": [
        "c",
        "cpp",
        "python",
        "go",
        "rust",
        "java",
        "javascript",
        "typescript"
      ]
    },
    "level": {
      "enum": [
        "junior",
        "mid",
        "senior"
      ]
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 180
    },
    "concepts": {
      "description": "What the candidate is practising: every concept the example tests or contains (manifest tests + present), without saying which one the bug is about.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line_count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]+$"
          },
          "line_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "attribution"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dimension",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[0-9]+$"
          },
          "dimension": {
            "$ref": "#/$defs/dimension"
          },
          "text": {
            "type": "string",
            "minLength": 10
          },
          "report": {
            "$ref": "#/$defs/bug_report"
          },
          "focus": {
            "description": "For improvements questions: the section the question is about, given to the candidate.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "start_line",
              "end_line"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "hints": {
            "description": "Nudges for questions other than bug questions (those keep theirs in report.hints). Each costs points when opened.",
            "$ref": "#/$defs/bug_report/properties/hints"
          }
        }
      }
    }
  },
  "$defs": {
    "dimension": {
      "enum": [
        "understanding",
        "bugs",
        "design",
        "improvements"
      ]
    },
    "bug_report": {
      "description": "A bug report for a bugs-dimension question: the starting point for finding the bug. expected/observed are quoted from the scenario run (manifest.scenario evidence).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "context",
        "steps",
        "expected",
        "observed",
        "hints"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5
        },
        "context": {
          "type": "string",
          "minLength": 20,
          "description": "Who saw what, where, in their words."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "text",
              "cost"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "text": {
                "type": "string",
                "minLength": 10
              },
              "cost": {
                "type": "number",
                "minimum": 0,
                "description": "Points taken off this question's score when the hint is opened."
              }
            }
          }
        }
      }
    }
  }
}
