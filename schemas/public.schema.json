{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readcode.example/schemas/public.schema.json",
  "title": "ReadCode public exercise definition (safe to send to candidates)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "language",
    "level",
    "estimated_minutes",
    "concepts",
    "files",
    "license",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^readcode-[0-9]{3,}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "intro": {
      "type": "string",
      "minLength": 10,
      "description": "Shown before the questions: what the code is and what was stubbed out."
    },
    "language": {
      "enum": [
        "c",
        "cpp",
        "python",
        "go",
        "rust",
        "java",
        "javascript",
        "typescript"
      ]
    },
    "level": {
      "enum": [
        "junior",
        "mid",
        "senior"
      ]
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 180
    },
    "concepts": {
      "description": "What the candidate is practising: every concept the example tests or contains (manifest tests + present), without saying which one the bug is about.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line_count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]+$"
          },
          "line_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "attribution"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dimension",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[0-9]+$"
          },
          "dimension": {
            "$ref": "#/$defs/dimension"
          },
          "text": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "$defs": {
    "dimension": {
      "enum": [
        "understanding",
        "bugs",
        "design",
        "improvements"
      ]
    }
  }
}
