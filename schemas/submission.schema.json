{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readcode.example/schemas/submission.schema.json",
  "title": "ReadCode candidate submission (what the candidate hands in; read by the grader)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exercise_id",
    "exercise_version",
    "candidate_id",
    "time_spent_minutes",
    "answers",
    "bugs",
    "improvements"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "exercise_id": {
      "type": "string",
      "pattern": "^readcode-[0-9]{3,}$"
    },
    "exercise_version": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "time_spent_minutes": {
      "type": "number",
      "minimum": 0
    },
    "answers": {
      "description": "Answer text per question id (Q1, Q2, ...), any dimension. Unanswered questions may be omitted or empty.",
      "type": "object",
      "propertyNames": {
        "pattern": "^Q[0-9]+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "bugs": {
      "description": "Line-anchored bug comments. ids are the candidate's own (e.g. c1), not key bug ids.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "locations",
          "severity",
          "confidence",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/range"
            }
          },
          "function": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "enum": [
              "guess",
              "fairly_sure",
              "certain"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/range"
            }
          }
        }
      },
      "description": "Free-form suggestions beyond the improvement questions, plus line comments of type Improvement."
    },
    "notes": {
      "description": "Line-anchored comments of type Question or Design concern. Not scored directly; context for whoever grades the design questions.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "locations",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "question",
              "design"
            ]
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/range"
            }
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "edits": {
      "description": "The candidate's edits to the code, one unified diff per changed file against the shipped file. Scratch work: not graded in v1, but a grader may read a written fix as evidence. All `locations` elsewhere in the submission use the ORIGINAL (shipped) line numbers, not the edited ones.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "patch"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "patch": {
            "type": "string",
            "pattern": "^--- a/"
          }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
